# ============ DATABASE ============
MONGO_URI=mongodb://pramaan_app:change_me_in_env@localhost:27017/pramaan_shield
DB_NAME=pramaan_shield
MONGO_ROOT_PASSWORD=root_secure_password_change_me
MONGO_APP_PASSWORD=app_secure_password_change_me

# ============ CACHE ============
REDIS_URL=redis://:redis_secure_password_change_me@localhost:6379/0
REDIS_PASSWORD=redis_secure_password_change_me

# ============ GEMINI ============
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ============ TELEGRAM ============
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhook
TELEGRAM_WEBHOOK_SECRET=random_secret_validated_on_each_update_32chars

# ============ CRYPTO ============
ENTITY_KEYS_DIR=app/crypto/keys/entities
PRAMAAN_CA_CERT_PATH=app/crypto/keys/pramaan_ca.pem
# Long random secret. Derives per-entity issuer API keys (HMAC-SHA256).
# Rotating it invalidates ALL issuer keys at once. MUST NOT be empty in prod.
ENTITY_KEY_PEPPER=replace_with_64_char_random_secret

# Secret used to sign report download URLs (HMAC-SHA256). SERVER-SIDE ONLY —
# never exposed to the browser. The frontend uses the server-issued download
# URL returned at report-generation time.
REPORT_ACCESS_SECRET=replace_with_random_report_access_secret

# ============ PRIVACY ============
IP_HMAC_SALT=long_random_secret_salt_for_ip_pseudonymization_32chars

# ============ APP ============
UPLOAD_DIR=/tmp/pramaan_uploads
TEMP_FILE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=30
HASH_HAMMING_THRESHOLD=10

# Max concurrent scan jobs (heavy CPU: pHash/OpenCV/ML). Tune to CPU cores.
MAX_CONCURRENT_SCANS=2

# CORS allow-list, comma-separated. Leave EMPTY for local-dev defaults
# (localhost:5173/3000 + vercel preview). Set explicitly in prod.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# CIDRs of proxies in FRONT of this API (e.g. 10.0.0.0/8,203.0.113.42/32).
# Empty = no trusted proxy → X-Forwarded-For is IGNORED (browser IP used).
# When set, only requests whose immediate TCP peer is in a listed CIDR may
# supply X-Forwarded-For; everything else falls back to the socket peer.
# TRUSTED_PROXY_CIDRS=

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only. Proxy route secrets (see frontend/app/api/issue-seal/route.ts).
# DO NOT prefix with NEXT_PUBLIC_ — that would ship it to browsers.
SEAL_API_KEY=replace_with_provisioned_issuer_api_key
