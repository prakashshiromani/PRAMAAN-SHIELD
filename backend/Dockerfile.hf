# HuggingFace Spaces Dockerfile for PRAMAAN-SHIELD Backend
# Port 7860 required by HF Spaces

FROM python:3.11-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user (HF Spaces requirement)
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

WORKDIR /home/user/app

# Install PyTorch CPU-only FIRST (reduces Docker layer size)
RUN pip install --no-cache-dir --user \
    torch>=2.1.0 torchaudio>=2.1.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install remaining dependencies
COPY --chown=user requirements-hf.txt .
RUN pip install --no-cache-dir --user -r requirements-hf.txt

# Copy app code
COPY --chown=user app/ ./app/

# Create required directories
RUN mkdir -p /tmp/pramaan_uploads logs

# HuggingFace Spaces uses port 7860
EXPOSE 7860

# Environment defaults (override via HF Spaces Secrets)
ENV GEMINI_MODEL=gemini-2.0-flash \
    MAX_CONCURRENT_SCANS=1 \
    UPLOAD_DIR=/tmp/pramaan_uploads \
    TEMP_FILE_TTL_SECONDS=60

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1"]
